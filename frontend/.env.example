# API base path (relative, proxied by Vite dev server)
VITE_API_URL=/api

# Backend origin for direct calls (bridge auth, image URLs)
VITE_API_ORIGIN=http://127.0.0.1:8000

# Filament admin panel URL
VITE_ADMIN_URL=http://127.0.0.1:8000/admin

# Set to true to enable MSW mock server (development only)
VITE_USE_MSW=false
