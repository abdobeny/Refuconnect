# RefuConnect — frontend production environment template.
#
# These values are baked into the bundle at BUILD time, so they must be set as
# environment variables on the static host (Vercel/Cloudflare Pages) before the
# build runs. Replace the domains with your actual deployment URLs.

# API base URL — absolute, pointing at the deployed backend.
VITE_API_URL=https://refuconnect-api.onrender.com/api

# Backend origin — used to build animal photo URLs and admin/bridge links.
VITE_API_ORIGIN=https://refuconnect-api.onrender.com

# Filament admin panel.
VITE_ADMIN_URL=https://refuconnect-api.onrender.com/admin
